{
  "name": "p5.zine",
  "version": "0.0.4",
  "description": "p5.zine is an open-sourced and friendly library for anyone curious about creative code and zine-making.",
  "main": "dist/p5.zine.js",
  "browser": "dist/p5.zine.js",
  "unpkg": "dist/p5.zine.js",
  "jsdelivr": "dist/p5.zine.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "docs:build": "node scripts/build-docs.js && npm --prefix docs run build",
    "docs:dev": "node scripts/build-docs.js && npm --prefix docs run dev",
    "dev": "node build.js --watch --serve --dev",
    "dev:all": "node scripts/dev-all.js",
    "preview": "node build.js --serve --dev",
    "playground": "npm run build && node scripts/build-playground.js",
    "test": "node build.js && node scripts/smoke-test.js",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munusshih/p5.zine.git"
  },
  "homepage": "https://github.com/munusshih/p5.zine",
  "bugs": {
    "url": "https://github.com/munusshih/p5.zine/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "p5.js",
    "zine",
    "creative coding",
    "zine-making",
    "zine-coding"
  ],
  "author": "Munus Shih, Tuan Huang, Iley Cao",
  "sideEffects": true,
  "license": "GPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jspdf": "^2.5.2",
    "p5": "1.11.13"
  }
}
